    <ui:VisualElement name="HealthBarBackground" class="healthbar-size" style="flex-grow: 1; position: absolute; height: 139px; background-image: url(&quot;project://database/Assets/_Assets/Art/UI/bar.png?fileID=2800000&amp;guid=9df30992280a2494eb011c55b387293d&amp;type=3#bar&quot;);">
        <ui:VisualElement name="HealthBarMask" style="flex-grow: 1; position: absolute; width: 85%; height: 100%; overflow: hidden; transition-property: width; transition-duration: 0.5s; transition-timing-function: ease-out;">
            <ui:VisualElement name="HealthBarFill" class="healthbar-size" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_Assets/Art/UI/inner.png?fileID=2800000&amp;guid=47eca86c24b9c1e42ac20106b00cd48f&amp;type=3#inner&quot;); position: absolute; height: 100%;" />
