        <ui:Label text="Label" name="HealthLabel" style="position: absolute; width: 100%; height: 100%; font-size: 16px; -unity-text-align: middle-left; padding-top: 10px; padding-right: 0; padding-bottom: 0; padding-left: 120px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; color: rgb(255, 255, 255);" />
    </ui:VisualElement>
